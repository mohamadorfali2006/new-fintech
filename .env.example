# Environment variables for NewFinTech
# Dev: copy to .env (SQLite default, zero setup).
# Prod: copy to .env.production and follow DEPLOY.md (Postgres + secrets).
# NEVER commit real secrets — .env / .env.production are git-ignored.

# --- Database ---------------------------------------------------------------
# Dev default: SQLite file. Keep working offline, no setup needed.
DATABASE_URL="file:./dev.db"
# Which provider the Prisma client was generated against ("sqlite" | "postgresql").
# lib/db.ts uses this to warn on URL/provider mismatches. Default when unset: sqlite.
DATABASE_PROVIDER="sqlite"

# Prod Postgres (docker-compose `db` service, or any managed Postgres):
#   1. Set DATABASE_PROVIDER="postgresql"
#   2. Set DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
#      (compose example: "postgresql://fintech:${POSTGRES_PASSWORD}@db:5432/fintech?schema=public")
#   3. Switch `provider` to "postgresql" in prisma/schema.prisma (one line),
#      run `npx prisma migrate dev` against the Postgres DB, commit migrations.
# Full steps: DEPLOY.md ("SQLite -> Postgres").
# TEMP_DATABASE_URL="file:./dev.db"

# --- Compose Postgres password (prod / compose only) -------------------------
# Read by docker-compose.yml for the `db` service. Generate with:
#   openssl rand -base64 24
POSTGRES_PASSWORD="CHANGE_ME_generate_a_strong_postgres_password"

# --- NextAuth v5 (Auth.js) ----------------------------------------------------
# Generate with: openssl rand -base64 32 (minimum 32 characters).
# ROTATION (do this before first prod deploy — the repo history once contained
# a placeholder secret, so treat any previously-used value as compromised):
#   1. Generate a fresh value:  openssl rand -base64 32
#   2. Set it as AUTH_SECRET in the prod environment (.env.production / host).
#   3. Redeploy. All existing sessions/JWTs are invalidated on rotation
#      (users simply sign in again) — there is no grace period.
#   4. Never reuse a dev secret in prod; never commit the real value.
AUTH_SECRET="CHANGE_ME_generate_a_random_secret_at_least_32_chars_long"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Assistant (OpenAI-compatible endpoint)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Bank integration (Plaid example - fill when you have real keys)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# TrueLayer (optional)
TRUELAYER_CLIENT_ID=""
TRUELAYER_CLIENT_SECRET=""

# Teller (optional)
TELLER_CLIENT_ID=""
TELLER_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NewFinTech"
