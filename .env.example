# Environment variables for NewFinTech
# Copy this to .env.local and fill in real values before deploying.

# Database
DATABASE_URL="file:./dev.db"
TEMP_DATABASE_URL="file:./dev.db"

# NextAuth v5 (Auth.js)
AUTH_SECRET="dev-secret-change-in-production-at-least-32-chars"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI Assistant (OpenAI-compatible endpoint)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Bank integration (Plaid example - fill when you have real keys)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# TrueLayer (optional)
TRUELAYER_CLIENT_ID=""
TRUELAYER_CLIENT_SECRET=""

# Teller (optional)
TELLER_CLIENT_ID=""
TELLER_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NewFinTech"
